{
    "name": "iobroker.tronity",
    "version": "1.2.2",
    "description": "Enables you to get vehicle data from Audi, BMW, Citroen, Cupra, DS, Fiat, Ford, Hyundai, Jaguar, Kia, MINI, Mercedes, Opel, Peugeot, Porsche, Renault, Seat, Skoda, Smart, Tesla, Vauxhall and Volkswagen",
    "author": {
        "name": "Sebastian",
        "email": "support@tronity.io"
    },
    "homepage": "https://github.com/tronity/ioBroker.tronity",
    "license": "MIT",
    "keywords": [
        "Audi",
        "BMW",
        "Citroen",
        "Cupra",
        "DS",
        "Fiat",
        "Ford",
        "Jaguar",
        "Kia",
        "MINI",
        "Mercedes",
        "Opel",
        "Peugeot",
        "Porsche",
        "Renault",
        "Seat",
        "Skoda",
        "Smart",
        "Tesla",
        "Vauxhall",
        "Volkswagen",
        "TRONITY",
        "ioBroker"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/tronity/ioBroker.tronity"
    },
    "dependencies": {
        "@iobroker/adapter-core": "^3.3.2",
        "axios": "^1.9.0",
        "memory-cache": "^0.2.0"
    },
    "devDependencies": {
        "@alcalzone/release-script": "^5.2.1",
        "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
        "@alcalzone/release-script-plugin-license": "^5.2.0",
        "@iobroker/adapter-dev": "^1.5.0",
        "@iobroker/dev-server": "^0.8.0",
        "@iobroker/eslint-config": "^2.2.0",
        "@iobroker/testing": "^5.2.2",
        "@tsconfig/node22": "^22.0.5",
        "@types/jest": "^30.0.0",
        "@types/memory-cache": "^0.2.6",
        "@types/node": "^22.0.0",
        "@types/proxyquire": "^1.3.31",
        "jest": "^30.4.2",
        "proxyquire": "^2.1.3",
        "rimraf": "^3.0.2",
        "source-map-support": "^0.5.21",
        "ts-jest": "^29.3.4",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3"
    },
    "main": "build/main.js",
    "files": [
        "admin{,/!(src)/**}/!(tsconfig|tsconfig.*).json",
        "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
        "build/",
        "www/",
        "io-package.json",
        "LICENSE"
    ],
    "scripts": {
        "prebuild": "rimraf build",
        "build": "build-adapter ts",
        "dev-server": "dev-server",
        "watch": "build-adapter ts --watch",
        "prebuild:ts": "rimraf build",
        "build:ts": "build-adapter ts",
        "watch:ts": "build-adapter ts --watch",
        "test:ts": "jest --config jest.config.cjs --runInBand",
        "test:package": "mocha test/package --exit",
        "test:unit": "mocha test/unit --exit",
        "test:integration": "mocha test/integration --exit",
        "test": "npm run test:ts && npm run test:package",
        "check": "tsc --noEmit",
        "lint": "eslint -c eslint.config.mjs .",
        "lint:fix": "eslint -c eslint.config.mjs . --fix",
        "translate": "translate-adapter",
        "release": "release-script"
    },
    "bugs": {
        "url": "https://github.com/tronity/ioBroker.tronity/issues"
    },
    "engines": {
        "node": ">=22"
    },
    "readmeFilename": "README.md",
    "overrides": {
        "serialize-javascript": "7.0.5",
        "esbuild": "0.25.12",
        "tough-cookie": "4.1.3",
        "xmldom": "npm:@xmldom/xmldom@0.9.10",
        "dom-compare-temp": {
            "xmldom": "npm:@xmldom/xmldom@0.9.10"
        },
        "request": {
            "qs": "6.15.2",
            "form-data": "2.5.6"
        }
    }
}
