{
	"i18n": true,
	"type": "panel",
	"items": {
		"_description": {
			"type": "staticText",
			"text": "Description",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 12,
			"lg": 12,
			"xl": 12
		},
		"client_id": {
			"type": "text",
			"label": "Client ID",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4
		},
		"client_secret": {
			"type": "password",
			"label": "Client Secret",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4
		},
		"_checkLogin": {
			"type": "sendTo",
			"command": "testConnection",
			"label": "Check Login Data",
			"jsonData": "{\"client_id\": \"${data.client_id}\", \"client_secret\": \"${data.client_secret}\"}",
			"showProcess": true,
			"variant": "contained",
			"result": {
				"ok": "Connection successful. %s vehicle(s) found."
			},
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4
		},
		"vehicle_id": {
			"type": "selectSendTo",
			"command": "validate",
			"label": "Vehicle",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4,
			"jsonData": "{\"client_id\": \"${data.client_id}\", \"client_secret\": \"${data.client_secret}\"}",
			"alsoDependsOn": [
				"client_id",
				"client_secret"
			],
			"help": "Vehicle list is loaded with the client ID and secret entered above."
		},
		"interval": {
			"type": "number",
			"label": "Polling interval (seconds)",
			"min": 30,
			"max": 3600,
			"default": 60,
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4
		}
	}
}
